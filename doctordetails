    <h1>Doctor Details</h1>
    <p><strong>Name:</strong> <?php echo $doctor['fullName']; ?></p>
    <p><strong>Email:</strong> <?php echo $doctor['email']; ?></p>
    <p><strong>Phone:</strong> <?php echo $doctor['phone']; ?></p>
