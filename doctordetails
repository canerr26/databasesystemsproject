    <h2>Visit History</h2>
    <?php if ($visits->num_rows > 0): ?>
        <table>
            <tr>
                <th>Patient</th>
                <th>Date</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
            <?php while ($row = $visits->fetch_assoc()): ?>
                <tr>
                    <td><?php echo $row['patient_name']; ?></td>
                    <td><?php echo $row['date']; ?></td>
                    <td><?php echo $row['status']; ?></td>
                    <td><a href="visit.php?doctor_id=<?php echo $row['doctorId']; ?>&patient_id=<?php echo $row['patientId']; ?>&date=<?php echo $row['date']; ?>">View Visit</a></td>
                </tr>
            <?php endwhile; ?>
        </table>
    <?php else: ?>
        <p>No visits found for this doctor.</p>
    <?php endif; ?>
