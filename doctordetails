<?php
// doctorDetails.php: Show details of a specific doctor

$conn = require_once 'db_connect.php';

if (!isset($_GET['id'])) {
    header("Location: departments.php");
    exit;
}

$doctorId = $_GET['id'];

// Get doctor details
$sql = "SELECT u.fullName, u.email, u.phone, d.specialty, dp.name AS department_name 
        FROM user u 
        JOIN doctor d ON u.userId = d.userId 
        JOIN department dp ON d.workingIn = dp.departmentId 
        WHERE u.userId = ?";
$stmt = $conn->prepare($sql);
$stmt->bind_param("i", $doctorId);
$stmt->execute();
$result = $stmt->get_result();
$doctor = $result->fetch_assoc();
$stmt->close();

if (!$doctor) {
    echo "Doctor not found.";
    exit;
}

// Get doctor visits
$sql = "SELECT v.*, u.fullName AS patient_name 
        FROM visit v 
        JOIN user u ON v.patientId = u.userId 
        WHERE v.doctorId = ?";
$stmt = $conn->prepare($sql);
$stmt->bind_param("i", $doctorId);
$stmt->execute();
$visits = $stmt->get_result();
$stmt->close();
?>

